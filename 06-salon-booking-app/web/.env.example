# Copy to .env.local for local development, or set these in Netlify →
# Site configuration → Environment variables. Both values are on Supabase →
# Project Settings → API. The anon key is designed to be public: the database
# rules (supabase/schema.sql) are what keep data private.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Leave both empty to run the built-in demo with invented data.
