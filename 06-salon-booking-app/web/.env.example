# Copy to .env.local for local development, or set these in Netlify →
# Project configuration → Environment variables. Both values are under Supabase →
# Connect (or Project Settings → Data API and API Keys). The publishable (or anon)
# key is designed to be public: the database rules (supabase/schema.sql) are what
# keep data private.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Leave both empty to run the built-in demo with invented data.

# Optional: the booking page's title and description in Google, and the preview card WhatsApp,
# Instagram, Facebook and iMessage show when someone shares the link. By default these are filled
# in from the business details in Settings (name, tagline, strapline and location) when the app is
# built, so after changing those, deploy again (Netlify → Deploys → Trigger deploy). Set these
# only to use different words. In Netlify, do NOT tick "Contains secret values" for any of the
# four below: they're written into the page for anyone to read, and a secret would stop the deploy.
# VITE_PUBLIC_NAME=Demo Nail Studio
# VITE_PUBLIC_DESCRIPTION=Gel, BIAB and nail art in Exampletown. See my free times and book online.

# The site's address, for the preview picture and Google's canonical link (https:// only).
# Netlify's own address for the site is used when this is empty.
# VITE_SITE_URL=https://book.example.com

# Google Search Console → Add property → URL prefix → HTML tag: the code inside content="…".
# VITE_GOOGLE_SITE_VERIFICATION=AbC123exampleCode-_xyz
