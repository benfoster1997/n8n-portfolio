{
  "name": "salon-booking-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Free, home-screen booking app for a one-person nail business: online booking, client records, deposits by bank transfer, email + one-tap WhatsApp reminders, takings report.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:db": "node --test tests/db/*.test.mjs",
    "test:e2e": "playwright test",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dancing-script": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/satisfy": "^5.3.0",
    "@supabase/supabase-js": "^2.45.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "pg": "^8.12.0",
    "sharp": "^0.33.5",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^2.0.5"
  }
}
